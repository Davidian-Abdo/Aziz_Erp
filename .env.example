# Copy to .env and fill in from the Supabase project dashboard.
#
# Both values are PUBLIC by design — they ship in the browser bundle. The anon
# key grants nothing on its own: every business table is behind RLS, and every
# policy requires a row in `app_user` (plan §2.5). Losing this key does not
# expose the store's books; losing the owner's password would.
#
# The service_role key must NEVER appear in this file or anywhere in src/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
