# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment — Supabase URL and anon key. Never committed.
.env
.env.*
!.env.example

# Supabase CLI local state — `supabase link` caches the project ref and
# credentials here. Never committed.
supabase/.temp
supabase/.branches

# Encrypted database dumps. They are encrypted, but they belong in the private
# backup repository and never in this one — an AES256 file in a public history
# is one leaked passphrase away from being the store's entire books.
backups/
*.sql.gpg

# Test / build artefacts
coverage
playwright-report
test-results
.vitest-summary.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
